#!/bin/sh
# Replace /usr/bin/asperadock symlink with a real wrapper file.
# IMPORTANT: must rm the symlink first — writing through it would overwrite
# /usr/lib/asperadock/asperadock (the Electron binary).
set -e
BIN="/usr/lib/asperadock/asperadock"
WRAPPER="/usr/bin/asperadock"
SRC="/usr/lib/asperadock/resources/asperadock-wrapper.sh"

if [ ! -x "$BIN" ]; then
  exit 0
fi

rm -f "$WRAPPER"

if [ -f "$SRC" ]; then
  cp "$SRC" "$WRAPPER"
else
  # Fallback if extraResource missing
  cat > "$WRAPPER" << 'INNER'
#!/bin/sh
set -eu
BIN="/usr/lib/asperadock/asperadock"
UD="${XDG_CONFIG_HOME:-$HOME/.config}/Aspera Dock"
mkdir -p "$UD" 2>/dev/null || true
# Only clear stale (dead-process) Chromium singleton files — never a live lock.
lock="$UD/SingletonLock"; cookie="$UD/SingletonCookie"; socket="$UD/SingletonSocket"; stale=0
if [ -L "$socket" ] && [ ! -e "$socket" ]; then stale=1; fi
if [ -L "$lock" ]; then
  target=$(readlink "$lock" 2>/dev/null || true); pid=${target##*-}
  case "$pid" in ''|*[!0-9]*) ;; *) if ! kill -0 "$pid" 2>/dev/null; then stale=1; fi ;; esac
fi
if [ "$stale" -eq 1 ]; then rm -f "$lock" "$cookie" "$socket" 2>/dev/null || true; fi
exec "$BIN" --no-sandbox --disable-gpu-sandbox --disable-gpu --disable-software-rasterizer --class=asperadock "$@"
INNER
fi
chmod 755 "$WRAPPER"
exit 0
